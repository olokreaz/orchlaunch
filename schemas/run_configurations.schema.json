{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/olokreaz/orchlaunch/master/schemas/run_configurations.schema.json",
  "title": "OrchLaunch Run Configurations",
  "description": "Run/debug configurations for OrchLaunch. Supports native, remote-debug, and compound configurations.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference for IDE support"
    },
    "configurations": {
      "type": "array",
      "description": "List of run/debug configurations",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/native"
          },
          {
            "$ref": "#/$defs/remote-debug"
          },
          {
            "$ref": "#/$defs/compound"
          }
        ]
      }
    }
  },
  "required": ["configurations"],
  "$defs": {
    "base-config": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Unique name of the configuration"
        },
        "type": {
          "type": "string",
          "enum": ["native", "remote-debug", "compound"],
          "description": "Type of the configuration"
        },
        "before": {
          "$ref": "#/$defs/before"
        }
      },
      "required": ["name", "type"],
      "additionalProperties": true
    },
    "native": {
      "allOf": [
        {
          "$ref": "#/$defs/base-config"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "native"
            },
            "target": {
              "type": "string",
              "description": "CMake target name or path to an executable. If omitted, only before-launch steps run."
            },
            "runtime": {
              "type": "string",
              "enum": ["executable", "static", "shared", "module", "object", "utility"],
              "description": "CMake target kind (used when target is a CMake target name)."
            },
            "cwd": {
              "type": "string",
              "description": "Working directory for the process. Supports macros: ${workspace}, ${orch}, ${buildDir}, ${sourceDir}, ${buildType}, ${toolchain}, ${target}, ${targetName}, ${targetPath}, ${targetDir}, ${projectName}, ${projectDir}, ${sourceParentDir}, ${userHome}, ${tempDir}, ${osName}, ${env:NAME}."
            },
            "args": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Command-line arguments passed to the program."
            },
            "inherit_env": {
              "type": "boolean",
              "default": true,
              "description": "Whether to inherit the parent process environment."
            },
            "sudo": {
              "type": "boolean",
              "default": false,
              "description": "Run the process with sudo (not compatible with console modes hidden/none)."
            },
            "environment": {
              "type": "object",
              "additionalProperties": { "type": "string" },
              "description": "Additional environment variables. Supports macros: ${workspace}, ${orch}, ${buildDir}, ${sourceDir}, ${buildType}, ${toolchain}, ${target}, ${targetName}, ${targetPath}, ${targetDir}, ${projectName}, ${projectDir}, ${sourceParentDir}, ${userHome}, ${tempDir}, ${osName}, ${env:NAME}."
            },
            "console": {
              "$ref": "#/$defs/console"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "remote-debug": {
      "allOf": [
        {
          "$ref": "#/$defs/base-config"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "remote-debug"
            },
            "symbol": {
              "type": "string",
              "description": "Path to the local symbol file (executable with debug info)."
            },
            "connection": {
              "type": "string",
              "pattern": "^[^:]+:\\d+$",
              "description": "Remote debugger connection as host:port."
            },
            "adapter": {
              "type": "string",
              "enum": ["gdb", "lldb"],
              "description": "Debug adapter to use for the remote connection."
            },
            "server": {
              "type": "string",
              "enum": ["lldb-server", "gdbserver"],
              "description": "Debug server the plugin starts for `symbol` before attaching. Leave empty to use a server you started yourself."
            }
          },
          "required": ["connection"],
          "additionalProperties": true
        }
      ]
    },
    "compound": {
      "allOf": [
        {
          "$ref": "#/$defs/base-config"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "compound"
            },
            "configurations": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" },
              "description": "Names of child configurations to run in sequence."
            }
          },
          "required": ["configurations"],
          "additionalProperties": true
        }
      ]
    },
    "console": {
      "type": "object",
      "description": "Console/terminal settings for native configurations",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["embedded", "hidden", "none"],
          "default": "embedded",
          "description": "embedded = terminal in Neovim, hidden = background process with completion notification, none = no output shown."
        },
        "keep_open": {
          "type": "boolean",
          "default": true,
          "description": "Keep the terminal buffer open after the process exits (embedded mode only)."
        },
        "clear_on_start": {
          "type": "boolean",
          "default": true,
          "description": "Clear the terminal buffer before starting the process (embedded mode only)."
        }
      },
      "additionalProperties": true
    },
    "step-log": {
      "description": "Where a process step's output goes. showIfError (default): quiet on success, full output in the output window on failure. show: always open the output window. none: never show; on failure only the last stderr line is notified. { file }: always written to the file (macros expanded, directory created).",
      "oneOf": [
        { "type": "string", "enum": ["none", "showIfError", "show"] },
        {
          "type": "object",
          "properties": {
            "file": { "type": "string", "minLength": 1, "description": "File path. Supports macros, e.g. ${tempDir}/orch/x.log." }
          },
          "required": ["file"],
          "additionalProperties": false
        }
      ]
    },
    "before": {
      "type": "object",
      "description": "Before-launch steps (run before the main configuration)",
      "properties": {
        "log": {
          "$ref": "#/$defs/step-log",
          "description": "Default output policy for every step in this block. A step's own log overrides it. Default: showIfError."
        },
        "tools": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string", "enum": ["build", "install"] },
              {
                "type": "object",
                "properties": {
                  "type": { "const": "build" },
                  "target": { "type": "string" }
                },
                "required": ["type"]
              },
              {
                "type": "object",
                "properties": {
                  "type": { "const": "install" },
                  "target": { "type": "string" }
                },
                "required": ["type"]
              },
              {
                "type": "object",
                "properties": {
                  "type": { "const": "external" },
                  "tool": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Name of an entry in external_tools.json."
                  },
                  "args": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Extra arguments appended after the tool's own args. Supports macros and ${var:name}."
                  },
                  "env": {
                    "type": "object",
                    "additionalProperties": { "type": "string" },
                    "description": "Environment variables that override the tool's environment for this call. Supports macros and ${var:name}."
                  },
                  "vars": {
                    "type": "object",
                    "additionalProperties": { "type": "string" },
                    "description": "Values for ${var:name} and ${var:name?default} in this step's args, env and the tool's fields."
                  },
                  "log": { "$ref": "#/$defs/step-log" }
                },
                "required": ["type", "tool"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "description": "Runs a program directly (no shell). Use sh -c explicitly for pipes.",
                "properties": {
                  "type": { "const": "exec" },
                  "argv": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string" },
                    "description": "Program and its arguments. Supports macros and ${var:name}."
                  },
                  "cwd": {
                    "type": "string",
                    "description": "Working directory. Supports macros."
                  },
                  "env": {
                    "type": "object",
                    "additionalProperties": { "type": "string" },
                    "description": "Environment variables for this command. Supports macros and ${var:name}."
                  },
                  "inherit_env": { "type": "boolean", "default": true },
                  "timeout": { "type": "number", "minimum": 1, "description": "Timeout in milliseconds." },
                  "capture": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                    "description": "Store stdout (without trailing newlines) as ${var:NAME} for later steps."
                  },
                  "log": { "$ref": "#/$defs/step-log" }
                },
                "required": ["type", "argv"],
                "additionalProperties": false
              }
            ]
          },
          "description": "Before-launch steps, run in order. Stops at the first failure: build, install, or an external tool with optional args, env and vars."
        }
      },
      "additionalProperties": true
    }
  }
}