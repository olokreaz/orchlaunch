{
  "$schema": "https://raw.githubusercontent.com/olokreaz/orchlaunch/master/schemas/external_tools.schema.json",
  "tools": [
    {
      "name": "gen-assets",
      "program": "${workspace}/tools/gen",
      "cwd": "${workspace}",
      "args": ["--release"],
      "environment": { "ASSET_DIR": "${workspace}/assets" }
    },
    {
      "name": "fmt",
      "program": "clang-format",
      "args": ["-i", "${workspace}/src/**/*.cpp"],
      "inherit_env": true
    }
  ]
}